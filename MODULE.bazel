"""bazel-rs built by Bazel: a dogfood/CI check (docs/SELF_BUILD.md).

Cargo stays the primary build (tests, releases, rust-analyzer). This module
builds the same crate with rules_rust, its third-party crates resolved by
crate_universe from the existing Cargo.toml and Cargo.lock (no second lockfile).
"""

module(
    name = "bazel_rs",
    version = "0.4.8",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")

# 0.75.0 is the first release whose known checksums include Rust 1.99.0
# (rust-toolchain.toml); ~/code's rules_rust 0.74.0 stops at 1.98.
bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # Keep in sync with rust-toolchain.toml's channel.
    versions = ["1.99.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates from Cargo.toml/Cargo.lock; BUILD.bazel reads them with
# `all_crate_deps`. The [patch.crates-io] path crates (vendor/) come along.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")
