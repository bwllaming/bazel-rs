load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# Includes every library's headers by their virtual include paths.
cc_library(
    name = "consumer",
    srcs = ["consumer.c"],
    hdrs = ["consumer.h"],
    deps = [
        "//lib:both",
        "//lib:prefixed",
        "//lib:stripped",
        "@ext//src/ext",
    ],
)

cc_binary(
    name = "app",
    srcs = ["main.c"],
    deps = [":consumer"],
)

cc_library(
    name = "dup_consumer",
    srcs = ["dup_consumer.c"],
    deps = ["//lib:hdr_and_textual"],
)
