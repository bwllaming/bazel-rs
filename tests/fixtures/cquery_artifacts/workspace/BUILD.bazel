load(":defs.bzl", "executable", "invalid", "predeclared", "probe", "required", "support", "writer", "wrong_owner")
platform(name = "platform")
writer(name = "a", path = "same.txt")
writer(name = "b", path = "same.txt")
writer(name = "c", path = "same.txt", content = "different")
alias(name = "aa", actual = ":a")
filegroup(name = "equal", srcs = [":a", ":b"])
filegroup(name = "unequal", srcs = [":a", ":c"])
filegroup(name = "forwarded", srcs = [":a", ":aa"])
filegroup(name = "ordered", srcs = [":b", ":aa", ":a"])
probe(name = "p_equal", dep = ":equal")
probe(name = "p_unequal", dep = ":unequal")
probe(name = "p_forwarded", dep = ":forwarded")
probe(name = "p_ordered", dep = ":ordered")
writer(name = "tree_a", path = "same.dir", kind = "tree")
writer(name = "tree_b", path = "same.dir", kind = "tree")
filegroup(name = "trees", srcs = [":tree_a", ":tree_b"])
probe(name = "p_trees", dep = ":trees")
writer(name = "link_a", path = "same.link", kind = "symlink", content = "target")
writer(name = "link_b", path = "same.link", kind = "symlink", content = "other-target")
filegroup(name = "links", srcs = [":link_a", ":link_b"])
probe(name = "p_links", dep = ":links")
writer(name = "cross_file", path = "cross")
writer(name = "cross_tree", path = "cross", kind = "tree")
filegroup(name = "cross_kind", srcs = [":cross_file", ":cross_tree"])
probe(name = "p_cross_kind", dep = ":cross_kind")
invalid(name = "orphan", mode = "orphan")
invalid(name = "duplicate", mode = "duplicate")
invalid(name = "tree_file", mode = "tree_file")
required(name = "bad_provider", dep = ":equal")
wrong_owner(name = "bad_executable", dep = ":a")
executable(name = "exe", data = "data.txt")
support(name = "support_files", dep = ":exe")
filegroup(name = "support_group", srcs = [":support_files"])
probe(name = "p_support", dep = ":support_group")
predeclared(name = "pre", out = "predeclared.txt")
writer(name = "over", path = "predeclared.txt")
filegroup(name = "pre_group", srcs = [":predeclared.txt", ":over"])
filegroup(name = "pre_reverse", srcs = [":over", ":predeclared.txt"])
probe(name = "p_predeclared", dep = ":pre_group")
probe(name = "p_pre_reverse", dep = ":pre_reverse")
