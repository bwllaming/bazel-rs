load(
    ":defs.bzl",
    "bound",
    "cat",
    "closure",
    "decl",
    "forward",
    "fwd",
    "gen",
    "hold",
    "leaf",
    "run_tool",
    "status",
    "status_exe",
    "status_files",
    "status_group",
    "status_lib",
    "status_report",
    "status_wrap",
    "tool",
    "use",
    "use_manifest",
    "via_closure",
)

leaf(name = "leaf")

hold(name = "hold", dep = ":leaf")

forward(name = "forward", dep = ":hold")

use(name = "use", dep = ":forward")

closure(name = "closure")

closure(name = "closure_range", kind = "range")

