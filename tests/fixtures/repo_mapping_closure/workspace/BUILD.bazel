load("//:defs.bzl", "asp_bin", "my_bin", "node")

# A data dependency on an output file: the generating rule's transitive
# packages (its exec tool in @maker) are the consumer's.
my_bin(
    name = "from_output",
    data = [
        "@ext//:e.txt",
        "@tool//:made.txt",
    ],
)

# A select() key's package (@cond) is a transitive package too.
my_bin(
    name = "from_select",
    data = ["@ext//:e.txt"],
    flag = select({
        "@cond//:opt": "opt",
        "//conditions:default": "other",
    }),
)

# Neither: only the main repository and @ext.
my_bin(
    name = "plain",
    data = ["@ext//:e.txt"],
)

# The target and host platform (no @platforms / @bazel_tools needed).
platform(name = "p")

# A select() key's config_setting depends on its constraint_values (@constr)
# and each constraint_value on its constraint_setting (@setting): their
# packages are transitive packages too (B62).
config_setting(
    name = "constrained",
    constraint_values = ["@constr//:v"],
)

my_bin(
    name = "from_constraint",
    data = ["@ext//:e.txt"],
    flag = select({
        ":constrained": "constrained",
        "//conditions:default": "other",
    }),
)

# An attribute aspect's own dependencies and toolchains (@asptool, @asptc)
# are transitive packages of the target whose dependency it is applied to.
node(name = "base")

asp_bin(
    name = "from_aspect",
    data = ["@ext//:e.txt"],
    deps = [":base"],
)

# A target over it inherits them.
my_bin(
    name = "over_aspect",
    data = [
        ":from_aspect",
        "@ext//:e.txt",
    ],
)

# A select() key's own package metadata (`package_metadata`, a no-config
# edge) is a transitive package of the dependent (B90): an alias with a
# configurable actual (bazel_skylib's `//lib:always_true`), an alias and a
# config_setting.
my_bin(
    name = "from_metadata_sel",
    data = ["@ext//:e.txt"],
    flag = select({
        "@meta//sel:key": "a",
        "//conditions:default": "other",
    }),
)

my_bin(
    name = "from_metadata_plain",
    data = ["@ext//:e.txt"],
    flag = select({
        "@meta//plain:key": "b",
        "//conditions:default": "other",
    }),
)

my_bin(
    name = "from_metadata_setting",
    data = ["@ext//:e.txt"],
    flag = select({
        "@meta//setting:key": "c",
        "//conditions:default": "other",
    }),
)

config_setting(
    name = "metadata_constrained",
    constraint_values = ["@meta//cv:v"],
)

my_bin(
    name = "from_metadata_constraint",
    data = ["@ext//:e.txt"],
    flag = select({
        ":metadata_constrained": "d",
        "//conditions:default": "other",
    }),
)
