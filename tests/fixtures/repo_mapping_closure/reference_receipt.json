  "startup": "--batch --ignore_all_rc_files --output_user_root=<private>",
  "command": "build --lockfile_mode=off --platforms=//:p --host_platform=//:p //:from_output //:from_select //:plain //:from_constraint",
  "workspace": "tests/fixtures/repo_mapping_closure/workspace"
 },
 "repo_mapping": {
  "bazel-bin/from_output.repo_mapping": ",ext,ext+\n,rmc,_main\n,tool,tool+\next+,ext,ext+\nmaker+,ext,ext+\ntool+,ext,ext+\ntool+,tool,tool+\n",
  "bazel-bin/from_select.repo_mapping": ",ext,ext+\n,rmc,_main\ncond+,ext,ext+\next+,ext,ext+\n",
  "bazel-bin/plain.repo_mapping": ",ext,ext+\n,rmc,_main\next+,ext,ext+\n",
