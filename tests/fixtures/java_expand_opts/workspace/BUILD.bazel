load("//bazel_internal/test_rules:defs.bzl", "consume", "generated", "probe", "resolved", "variables")
platform(name = "host")

variables(name = "vars", value = "tool value")
probe(name = "tokens", toolchains = [":vars"], misc = ["-A 'two words' plain", "", "''", "$$HOME", "$(COMPILATION_MODE)", "$(CUSTOM)", "$(TOOL)", "$(CHOICE)", "a\nb", "a\\ b", '"a\\qb"'])
probe(name = "raw", toolchains = [":vars"], tokenize = False, attribute = "javacopts", javacopts = ["-A 'two words' plain", "", "''", "$$HOME", "$(COMPILATION_MODE)", "$(CUSTOM)", "$(TOOL)", "$(CHOICE)", "a\nb", "a\\ b", '"a\\qb"'])
consume(name = "consumed", dep = ":tokens")
exports_files(["source.txt", "data.txt"])
alias(name = "aliased", actual = ":source.txt")
probe(name = "locations", srcs = [":aliased"], data = [":data.txt"], misc = ["$(location :aliased)", "$(location :source.txt)", "$(location :data.txt)", "$(execpath :aliased)", "$(rootpath :aliased)", "$(rlocationpath :aliased)"])
probe(name = "exec_locations", exec_paths = True, srcs = [":aliased"], misc = ["$(location :aliased)", "$(rootpath :source.txt)"])
probe(name = "exec_data", exec_paths = True, data = [":data.txt"], misc = ["$(location :data.txt)"])
probe(name = "unknown", misc = ["$(UNKNOWN)"])
probe(name = "function", misc = ["$(unknown arg)"])
probe(name = "quote", misc = ["good 'bad"])
probe(name = "missing_attr", attribute = "absent")
probe(name = "wrong_attr", attribute = "case")
probe(name = "empty_wrong_attr", attribute = "ints")
probe(name = "missing_tokenize", case = "missing_tokenize")
probe(name = "positional_tokenize", case = "positional_tokenize")
probe(name = "named_ctx", case = "named_ctx")
probe(name = "bad_ctx", case = "bad_ctx")
probe(name = "bad_attr", case = "bad_attr")
probe(name = "bad_tokenize", case = "bad_tokenize")
probe(name = "bad_exec", case = "bad_exec")
probe(name = "mutate", case = "mutate")
probe(name = "escape", case = "escape")
probe(name = "escaped", case = "escaped", dep = ":escape")

toolchain_type(name = "type")
toolchain(name = "tc", toolchain_type = ":type", toolchain = ":vars")
resolved(name = "resolved", misc = ["$(TOOL)", "$(COMPILATION_MODE)", "$(BINDIR)", "$(GENDIR)"])
generated(name = "generated")
alias(name = "gen_alias", actual = ":generated")
probe(name = "generated_runfiles", srcs = [":gen_alias"], misc = ["$(locations :gen_alias)", "$(execpaths :generated)", "$(rootpaths :gen_alias)", "$(rlocationpaths :gen_alias)"])
probe(name = "generated_exec", exec_paths = True, srcs = [":gen_alias"], misc = ["$(locations :gen_alias)"])
probe(name = "default_paths", data = [":data.txt"], misc = ["$(location :data.txt)"])
probe(name = "builtin_tags", attribute = "tags", tags = ["a b", "$(COMPILATION_MODE)"])
