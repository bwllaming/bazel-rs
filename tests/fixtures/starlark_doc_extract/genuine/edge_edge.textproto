rule_info {
  rule_name: "tool_rule"
  doc_string: "Leading blank line doc."
  attribute {
    name: "name"
    doc_string: "A unique name for this target."
    type: NAME
    mandatory: true
  }
  attribute {
    name: "tool"
    doc_string: "Exec tool."
    type: LABEL
    default_value: "None"
  }
  attribute {
    name: "srcs"
    type: LABEL_LIST
    provider_name_group {
      provider_name: "DefaultInfo"
      provider_name: "ExtInfoAlias"
      origin_key {
        name: "DefaultInfo"
        file: "<native>"
      }
      origin_key {
        name: "ExtInfo"
        file: "@dep_mod//sub:lib.bzl"
      }
    }
    default_value: "[]"
  }
  attribute {
    name: "neg"
    type: INT
    default_value: "-5"
  }
  attribute {
    name: "s"
    type: STRING
    default_value: "\"quote\\\"back\\\\slash\\nnewline\""
  }
  attribute {
    name: "mixed"
    type: STRING
    default_value: "\"\""
    values: "\"x\""
    values: "\"y\""
  }
  attribute {
    name: "lkd"
    type: LABEL_STRING_DICT
    default_value: "{\"//edge:a\": \"x\", \"@dep_mod//sub:lib\": \"y\"}"
  }
  attribute {
    name: "skd"
    type: LABEL_DICT_UNARY
    default_value: "{\"k\": \"@dep_mod//sub:lib\"}"
  }
  attribute {
    name: "lld"
    type: LABEL_LIST_DICT
    default_value: "{\"k\": [\"//edge:a\", \"//edge\"]}"
  }
  attribute {
    name: "ll"
    type: LABEL_LIST
    default_value: "[\"//edge\", \"//:sde_fixture\", \"@dep_mod\"]"
  }
  origin_key {
    name: "tool_rule"
    file: "//edge:edge.bzl"
  }
}
