    natively_defined: true
  }
  attribute {
    name: "aspect_hints"
    type: LABEL_LIST
    default_value: "None"
    natively_defined: true
  }
  attribute {
    name: "toolchains"
    type: LABEL_LIST
    provider_name_group {
      provider_name: "TemplateVariableInfo"
      origin_key {
        name: "TemplateVariableInfo"
        file: "<native>"
      }
    }
    default_value: "None"
    natively_defined: true
  }
  attribute {
    name: "exec_properties"
    type: STRING_DICT
    default_value: "None"
    natively_defined: true
  }
  attribute {
