      provider_name: "ConstraintValueInfo"
      origin_key {
        name: "ConstraintValueInfo"
        file: "<native>"
      }
    }
    default_value: "None"
    natively_defined: true
  }
  attribute {
    name: "srcs"
    doc_string: "Sources."
    type: LABEL_LIST
    default_value: "None"
  }
  origin_key {
    name: "from_rule"
    file: "//inherit:defs.bzl"
  }
}
