  attribute {
    name: "srcs"
    doc_string: "The target producing the file among other outputs"
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "subpath"
    doc_string: "Relative path to the file"
    type: STRING
    mandatory: true
  }
  origin_key {
    name: "select_file"
    file: "@bazel_skylib//rules:select_file.bzl"
  }
}
