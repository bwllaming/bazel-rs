func_info {
  function_name: "build_test"
  parameter {
    name: "name"
    doc_string: "The name of the test rule."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "targets"
    doc_string: "A list of targets to ensure build."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "kwargs"
    doc_string: "The [common attributes for tests](https://bazel.build/reference/be/common-definitions#common-attributes-tests)."
    role: PARAM_ROLE_KWARGS
  }
  doc_string: "Test rule checking that other targets build.\n\nThis works not by an instance of this test failing, but instead by\nthe targets it depends on failing to build, and hence failing\nthe attempt to run this test.\n\nTypical usage:\n\n```\n  load(\"@bazel_skylib//rules:build_test.bzl\", \"build_test\")\n  build_test(\n      name = \"my_build_test\",\n      targets = [\n          \"//some/package:rule\",\n      ],\n  )\n```\n"
  origin_key {
    name: "build_test"
    file: "@bazel_skylib//rules:build_test.bzl"
  }
}
func_info {
  function_name: "copy_directory"
  parameter {
    name: "name"
    doc_string: "Name of the rule."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "src"
    doc_string: "The directory to make a copy of. Can be a source directory or TreeArtifact."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "out"
    doc_string: "Path of the output directory, relative to this package."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "kwargs"
    doc_string: "further keyword arguments, e.g. `visibility`"
    role: PARAM_ROLE_KWARGS
  }
  doc_string: "Copies a directory to another location.\n\nThis rule uses a Bash command on Linux/macOS/non-Windows, and a cmd.exe command on Windows (no Bash is required).\n\nIf using this rule with source directories, it is recommended that you use the\n`--host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1` startup option so that changes\nto files within source directories are detected. See\nhttps://github.com/bazelbuild/bazel/commit/c64421bc35214f0414e4f4226cc953e8c55fa0d2\nfor more context.\n"
  origin_key {
    name: "copy_directory"
    file: "@bazel_skylib//rules/private:copy_directory_private.bzl"
  }
}
func_info {
  function_name: "copy_file"
  parameter {
    name: "name"
    doc_string: "Name of the rule."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "src"
    doc_string: "A Label. The file to make a copy of. (Can also be the label of a rule\nthat generates a file.)"
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "out"
    doc_string: "Path of the output file, relative to this package."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "is_executable"
    doc_string: "A boolean. Whether to make the output file executable. When\nTrue, the rule\'s output can be executed using `bazel run` and can be\nin the srcs of binary and test rules that require executable sources.\nWARNING: If `allow_symlink` is True, `src` must also be executable."
    default_value: "False"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "allow_symlink"
    doc_string: "A boolean. Whether to allow symlinking instead of copying.\nWhen False, the output is always a hard copy. When True, the output\n*can* be a symlink, but there is no guarantee that a symlink is\ncreated (i.e., at the time of writing, we don\'t create symlinks on\nWindows). Set this to True if you need fast copying and your tools can\nhandle symlinks (which most UNIX tools can)."
    default_value: "False"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "kwargs"
    doc_string: "further keyword arguments, e.g. `visibility`"
    role: PARAM_ROLE_KWARGS
  }
  doc_string: "Copies a file to another location.\n\n`native.genrule()` is sometimes used to copy files (often wishing to rename them). The \'copy_file\' rule does this with a simpler interface than genrule.\n\nThis rule uses a Bash command on Linux/macOS/non-Windows, and a cmd.exe command on Windows (no Bash is required).\n"
  origin_key {
    name: "copy_file"
    file: "@bazel_skylib//rules/private:copy_file_private.bzl"
  }
}
func_info {
  function_name: "write_file"
  parameter {
    name: "name"
    doc_string: "Name of the rule."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "out"
    doc_string: "Path of the output file, relative to this package."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "content"
    doc_string: "A list of strings. Lines of text, the contents of the file.\nNewlines are added automatically after every line except the last one."
    default_value: "[]"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "is_executable"
    doc_string: "A boolean. Whether to make the output file executable.\nWhen True, the rule\'s output can be executed using `bazel run` and can\nbe in the srcs of binary and test rules that require executable\nsources."
    default_value: "False"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "newline"
    doc_string: "one of [\"auto\", \"unix\", \"windows\"]: line endings to use. \"auto\"\nfor platform-determined, \"unix\" for LF, and \"windows\" for CRLF."
    default_value: "\"auto\""
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "kwargs"
    doc_string: "further keyword arguments, e.g. `visibility`"
    role: PARAM_ROLE_KWARGS
  }
  doc_string: "Creates a UTF-8 encoded text file."
  origin_key {
    name: "write_file"
    file: "@bazel_skylib//rules/private:write_file_private.bzl"
  }
}
