rule_info {
  rule_name: "diff_test"
  doc_string: "A test that compares two files.\n\nThe test succeeds if the files\' contents match."
  attribute {
    name: "name"
    doc_string: "A unique name for this target."
    type: NAME
    mandatory: true
  }
  attribute {
    name: "file1"
    doc_string: "Label of the file to compare to `file2`."
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "file2"
    doc_string: "Label of the file to compare to `file1`."
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "failure_message"
    doc_string: "Additional message to log if the files\' contents do not match."
    type: STRING
    default_value: "\"\""
  }
  origin_key {
    name: "diff_test"
    file: "@bazel_skylib//rules:diff_test.bzl"
  }
  test: true
  executable: true
}
rule_info {
  rule_name: "expand_template"
  doc_string: "Template expansion\n\nThis performs a simple search over the template file for the keys in\nsubstitutions, and replaces them with the corresponding values.\n\nThere is no special syntax for the keys. To avoid conflicts, you would need to\nexplicitly add delimiters to the key strings, for example \"{KEY}\" or \"@KEY@\"."
  attribute {
    name: "name"
    doc_string: "A unique name for this target."
    type: NAME
    mandatory: true
  }
  attribute {
    name: "template"
    doc_string: "The template file to expand."
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "substitutions"
    doc_string: "A dictionary mapping strings to their substitutions."
    type: STRING_DICT
    mandatory: true
  }
  attribute {
    name: "out"
    doc_string: "The destination of the expanded file."
    type: OUTPUT
    mandatory: true
    nonconfigurable: true
  }
  origin_key {
    name: "expand_template"
    file: "@bazel_skylib//rules:expand_template.bzl"
  }
}
rule_info {
  rule_name: "native_binary"
  doc_string: "Wraps a pre-built binary or script with a binary rule.\n\nYou can \"bazel run\" this rule like any other binary rule, and use it as a tool\nin genrule.tools for example. You can also augment the binary with runfiles."
  attribute {
    name: "name"
    doc_string: "A unique name for this target."
    type: NAME
    mandatory: true
  }
  attribute {
    name: "src"
    doc_string: "path of the pre-built executable"
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "data"
    doc_string: "data dependencies. See https://bazel.build/reference/be/common-definitions#typical.data"
    type: LABEL_LIST
    default_value: "[]"
  }
  attribute {
    name: "out"
    doc_string: "An output name for the copy of the binary. Defaults to name.exe. (We add .exe to the name by default because it\'s required on Windows and tolerated on other platforms.)"
    type: STRING
    default_value: "\"\""
  }
  attribute {
    name: "env"
    doc_string: "Environment variables to set when running the binary."
    type: STRING_DICT
    default_value: "{}"
  }
  origin_key {
    name: "native_binary"
    file: "@bazel_skylib//rules:native_binary.bzl"
  }
  executable: true
}
rule_info {
  rule_name: "native_test"
  doc_string: "Wraps a pre-built binary or script with a test rule.\n\nYou can \"bazel test\" this rule like any other test rule. You can also augment\nthe binary with runfiles."
  attribute {
    name: "name"
    doc_string: "A unique name for this target."
    type: NAME
    mandatory: true
  }
  attribute {
    name: "src"
    doc_string: "path of the pre-built executable"
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "data"
    doc_string: "data dependencies. See https://bazel.build/reference/be/common-definitions#typical.data"
    type: LABEL_LIST
    default_value: "[]"
  }
  attribute {
    name: "out"
    doc_string: "An output name for the copy of the binary. Defaults to name.exe. (We add .exe to the name by default because it\'s required on Windows and tolerated on other platforms.)"
    type: STRING
    default_value: "\"\""
  }
  attribute {
    name: "env"
    doc_string: "Environment variables to set when running the binary."
    type: STRING_DICT
    default_value: "{}"
  }
  origin_key {
    name: "native_test"
    file: "@bazel_skylib//rules:native_binary.bzl"
  }
  test: true
  executable: true
}
rule_info {
  rule_name: "run_binary"
  doc_string: "Runs a binary as a build action.\n\nThis rule does not require Bash (unlike `native.genrule`)."
  attribute {
    name: "name"
    doc_string: "A unique name for this target."
    type: NAME
    mandatory: true
  }
  attribute {
    name: "tool"
    doc_string: "The tool to run in the action.\n\nMust be the label of a *_binary rule, of a rule that generates an executable file, or of a file that can be executed as a subprocess (e.g. an .exe or .bat file on Windows or a binary with executable permission on Linux). This label is available for `$(execpath)` and `$(location)` expansion in `args` and `env`."
    type: LABEL
    mandatory: true
  }
  attribute {
    name: "env"
    doc_string: "Environment variables of the action.\n\nSubject to  [`$(execpath)` and `$(location)`](https://bazel.build/reference/be/make-variables#predefined_label_variables) expansion."
    type: STRING_DICT
    default_value: "{}"
  }
  attribute {
    name: "srcs"
    doc_string: "Additional inputs of the action.\n\nThese labels are available for `$(execpath)` and `$(location)` expansion in `args` and `env`."
    type: LABEL_LIST
    default_value: "[]"
  }
  attribute {
    name: "outs"
    doc_string: "Output files generated by the action.\n\nThese labels are available for `$(execpath)` and `$(location)` expansion in `args` and `env`."
    type: OUTPUT_LIST
    mandatory: true
    nonconfigurable: true
  }
  attribute {
    name: "args"
    doc_string: "Command line arguments of the binary.\n\nSubject to [`$(execpath)` and `$(location)`](https://bazel.build/reference/be/make-variables#predefined_label_variables) expansion."
    type: STRING_LIST
    default_value: "[]"
  }
  origin_key {
    name: "run_binary"
    file: "@bazel_skylib//rules:run_binary.bzl"
  }
}
