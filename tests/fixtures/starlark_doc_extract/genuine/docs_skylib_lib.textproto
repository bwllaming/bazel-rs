func_info {
  function_name: "selects.config_setting_group"
  parameter {
    name: "name"
    doc_string: "The group\'s name. This is how `select()`s reference it."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "match_any"
    doc_string: "A list of `config_settings`. This group matches if *any* member\nin the list matches. If this is set, `match_all` must not be set."
    default_value: "[]"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "match_all"
    doc_string: "A list of `config_settings`. This group matches if *every*\nmember in the list matches. If this is set, `match_any` must be not\nset."
    default_value: "[]"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "visibility"
    doc_string: "Visibility of the config_setting_group."
    default_value: "None"
    role: PARAM_ROLE_ORDINARY
  }
  doc_string: "Matches if all or any of its member `config_setting`s match.\n\nExample:\n\n  ```build\n  config_setting(name = \"one\", define_values = {\"foo\": \"true\"})\n  config_setting(name = \"two\", define_values = {\"bar\": \"false\"})\n  config_setting(name = \"three\", define_values = {\"baz\": \"more_false\"})\n\n  config_setting_group(\n      name = \"one_two_three\",\n      match_all = [\":one\", \":two\", \":three\"]\n  )\n\n  cc_binary(\n      name = \"myapp\",\n      srcs = [\"myapp.cc\"],\n      deps = select({\n          \":one_two_three\": [\":special_deps\"],\n          \"//conditions:default\": [\":default_deps\"]\n      })\n  ```\n"
  origin_key {
    name: "_config_setting_group"
    file: "@bazel_skylib//lib:selects.bzl"
  }
}
func_info {
  function_name: "selects.with_or"
  parameter {
    name: "input_dict"
    doc_string: "The same dictionary `select()` takes, except keys may take\neither the usual form `\"//foo:config1\"` or\n`(\"//foo:config1\", \"//foo:config2\", ...)` to signify\n`//foo:config1` OR `//foo:config2` OR `...`."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "no_match_error"
    doc_string: "Optional custom error to report if no condition matches."
    default_value: "\"\""
    role: PARAM_ROLE_ORDINARY
  }
  doc_string: "Drop-in replacement for `select()` that supports ORed keys.\n\nExample:\n\n      ```build\n      deps = selects.with_or({\n          \"//configs:one\": [\":dep1\"],\n          (\"//configs:two\", \"//configs:three\"): [\":dep2or3\"],\n          \"//configs:four\": [\":dep4\"],\n          \"//conditions:default\": [\":default\"]\n      })\n      ```\n\n      Key labels may appear at most once anywhere in the input.\n"
  return {
    doc_string: "A native `select()` that expands\n\n`(\"//configs:two\", \"//configs:three\"): [\":dep2or3\"]`\n\nto\n\n```build\n\"//configs:two\": [\":dep2or3\"],\n\"//configs:three\": [\":dep2or3\"],\n```"
  }
  origin_key {
    name: "_with_or"
    file: "@bazel_skylib//lib:selects.bzl"
  }
}
func_info {
  function_name: "selects.with_or_dict"
  parameter {
    name: "input_dict"
    doc_string: "Same as `with_or`."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  doc_string: "Variation of `with_or` that returns the dict of the `select()`.\n\nUnlike `select()`, the contents of the dict can be inspected by Starlark\nmacros.\n"
  return {
    doc_string: "A dictionary usable by a native `select()`."
  }
  origin_key {
    name: "_with_or_dict"
    file: "@bazel_skylib//lib:selects.bzl"
  }
}
