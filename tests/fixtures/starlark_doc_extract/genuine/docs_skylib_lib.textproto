func_info {
  function_name: "analysistest.begin"
  parameter {
    name: "ctx"
    doc_string: "The Starlark context. Pass the implementation function\'s `ctx` argument\nin verbatim."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  doc_string: "Begins an analysis test.\n\nThis should be the first function called in an analysis test implementation\nfunction. It initializes a \"test environment\" that is used to collect\nassertion failures so that they can be reported and logged at the end of the\ntest.\n"
  return {
    doc_string: "A test environment struct that must be passed to assertions and finally to\n`analysistest.end`. Do not rely on internal details about the fields in this\nstruct as it may change."
  }
  origin_key {
    name: "_begin_analysis_test"
    file: "@bazel_skylib//lib:unittest.bzl"
  }
}
func_info {
  function_name: "analysistest.end"
  parameter {
    name: "env"
    doc_string: "The test environment returned by `analysistest.begin`."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  doc_string: "Ends an analysis test and logs the results.\n\nThis must be called and returned at the end of an analysis test implementation function so\nthat the results are reported.\n"
  return {
    doc_string: "A list of providers needed to automatically register the analysis test result."
  }
  origin_key {
    name: "_end_analysis_test"
    file: "@bazel_skylib//lib:unittest.bzl"
  }
}
