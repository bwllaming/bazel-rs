}
func_info {
  function_name: "analysistest.make"
  parameter {
    name: "impl"
    doc_string: "The implementation function of the unit test."
    mandatory: true
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "expect_failure"
    doc_string: "If true, the analysis test will expect the target_under_test\nto fail. Assertions can be made on the underlying failure using asserts.expect_failure"
    default_value: "False"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "attrs"
    doc_string: "An optional dictionary to supplement the attrs passed to the\nunit test\'s `rule()` constructor."
    default_value: "{}"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "fragments"
    doc_string: "An optional list of fragment names that can be used to give rules access to\nlanguage-specific parts of configuration."
    default_value: "[]"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "config_settings"
    doc_string: "A dictionary of configuration settings to change for the target under\ntest and its dependencies. This may be used to essentially change \'build flags\' for\nthe target under test, and may thus be utilized to test multiple targets with different\nflags in a single build"
    default_value: "{}"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "extra_target_under_test_aspects"
    doc_string: "An optional list of aspects to apply to the target_under_test\nin addition to those set up by default for the test harness itself."
    default_value: "[]"
    role: PARAM_ROLE_ORDINARY
  }
  parameter {
    name: "doc"
    doc_string: "A description of the rule that can be extracted by documentation generating tools."
    default_value: "\"\""
    role: PARAM_ROLE_ORDINARY
  }
  doc_string: "Creates an analysis test rule from its implementation function.\n\nAn analysis test verifies the behavior of a \"real\" rule target by examining\nand asserting on the providers given by the real target.\n\nEach analysis test is defined in an implementation function that must then be\nassociated with a rule so that a target can be built. This function handles\nthe boilerplate to create and return a test rule and captures the\nimplementation function\'s name so that it can be printed in test feedback.\n\nAn example of an analysis test:\n\n```\ndef _your_test(ctx):\n  env = analysistest.begin(ctx)\n\n  # Assert statements go here\n\n  return analysistest.end(env)\n\nyour_test = analysistest.make(_your_test)\n```\n\nRecall that names of test rules must end in `_test`.\n"
  return {
    doc_string: "A rule definition that should be stored in a global whose name ends in\n`_test`."
  }
  origin_key {
    name: "_make_analysis_test"
    file: "@bazel_skylib//lib:unittest.bzl"
  }
}
