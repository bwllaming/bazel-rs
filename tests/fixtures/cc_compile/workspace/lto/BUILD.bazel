load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":config.bzl", "config")

filegroup(name = "empty")

config(name = "config")

cc_toolchain(
    name = "cc_tc",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":config",
)

toolchain(
    name = "tc",
    toolchain = ":cc_tc",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

cc_library(
    name = "lib",
    srcs = ["lib.c"],
    hdrs = ["lib.h"],
    copts = ["-DLIB"],
    features = ["thin_lto"],
)

cc_binary(
    name = "bin",
    srcs = ["main.c"],
    features = ["thin_lto"],
    deps = [":lib"],
)

cc_test(
    name = "test",
    srcs = ["main.c"],
    features = [
        "thin_lto",
        "thin_lto_linkstatic_tests_use_shared_nonlto_backends",
    ],
    deps = [":lib"],
)
