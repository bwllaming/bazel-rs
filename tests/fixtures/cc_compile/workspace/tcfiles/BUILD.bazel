load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load(":config.bzl", "config")

filegroup(name = "compiler", srcs = ["compiler_only.txt"])

filegroup(name = "assembler", srcs = ["as_only.txt"])

filegroup(name = "archiver", srcs = ["ar_only.txt"])

filegroup(name = "linker", srcs = ["linker_only.txt"])

filegroup(
    name = "all",
    srcs = [
        "ar_only.txt",
        "as_only.txt",
        "compiler_only.txt",
        "linker_only.txt",
    ],
)

config(name = "config")

cc_toolchain(
    name = "cc_tc",
    all_files = ":all",
    ar_files = ":archiver",
    as_files = ":assembler",
    compiler_files = ":compiler",
    dwp_files = ":linker",
    linker_files = ":linker",
    objcopy_files = ":linker",
    strip_files = ":linker",
    toolchain_config = ":config",
)

toolchain(
    name = "tc",
    toolchain = ":cc_tc",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

cc_library(
    name = "lib",
    srcs = [
        "asm.S",
        "plain.s",
        "lib.c",
    ],
)
