<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<query version="2">
    <source-file location="${WORKSPACE}/conf/BUILD.bazel:1:1" name="//conf:BUILD.bazel" package_contains_errors="false">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <rule class="config_setting" location="${WORKSPACE}/conf/BUILD.bazel:1:15" name="//conf:fast">
        <string name="name" value="fast"/>
        <list name="visibility">
            <label value="//visibility:public"/>
        </list>
        <dict name="define_values">
            <pair>
                <string value="speed"/>
                <string value="fast"/>
            </pair>
        </dict>
    </rule>
    <rule class="config_setting" location="${WORKSPACE}/conf/BUILD.bazel:7:15" name="//conf:slow">
        <string name="name" value="slow"/>
        <list name="visibility">
            <label value="//visibility:public"/>
        </list>
        <dict name="values">
            <pair>
                <string value="compilation_mode"/>
                <string value="opt"/>
            </pair>
        </dict>
    </rule>
    <source-file location="${WORKSPACE}/other/BUILD.bazel:1:1" name="//other:BUILD.bazel" package_contains_errors="false">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <rule class="filegroup" location="${WORKSPACE}/other/BUILD.bazel:1:10" name="//other:thing">
        <string name="name" value="thing"/>
        <list name="visibility">
            <label value="//visibility:public"/>
        </list>
        <list name="srcs">
            <label value="//other:thing.txt"/>
        </list>
        <rule-input name="//other:thing.txt"/>
    </rule>
    <source-file location="${WORKSPACE}/other/thing.txt:1:1" name="//other:thing.txt">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <source-file location="${WORKSPACE}/pkg/BUILD.bazel:1:1" name="//pkg:BUILD.bazel" package_contains_errors="false">
        <load name="//rules:defs.bzl"/>
        <load name="//rules:common.bzl"/>
        <load name="//rules:macros.bzl"/>
        <feature name="feat_a"/>
        <feature name="-feat_b"/>
        <package-group name="//vis:friends"/>
        <visibility-label name="//vis:friends"/>
    </source-file>
    <rule class="alias" location="${WORKSPACE}/pkg/BUILD.bazel:130:6" name="//pkg:al">
        <string name="name" value="al"/>
        <label name="actual" value="//pkg:gen"/>
        <rule-input name="//pkg:gen"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <rule class="kitchen" location="${WORKSPACE}/pkg/BUILD.bazel:16:8" name="//pkg:all_types">
        <string name="name" value="all_types"/>
        <string name="deprecation" value="old"/>
        <list name="tags">
            <string value="t1"/>
        </list>
        <boolean name="testonly" value="true"/>
        <string name="s" value="hello &lt;world&gt; &amp; &quot;q&quot; = 'x'&#10;&#9;tab Ã©"/>
        <int name="i" value="-7"/>
        <boolean name="b" value="true"/>
        <label name="lbl" value="//pkg:data.txt"/>
        <list name="lbls">
            <label value="//pkg:data.txt"/>
            <label value="//other:thing"/>
        </list>
        <label name="tool" value="//pkg:tool.sh"/>
        <list name="strs">
            <string value="a"/>
            <string value="b"/>
        </list>
        <list name="ints">
            <int value="1"/>
            <int value="-2"/>
            <int value="2147483647"/>
        </list>
        <dict name="sd">
            <pair>
                <string value="k1"/>
                <string value="v1"/>
            </pair>
            <pair>
                <string value="k2"/>
                <string value="v2"/>
            </pair>
        </dict>
        <dict name="sld">
            <pair>
                <string value="k"/>
                <list>
                    <string value="x"/>
                    <string value="y"/>
                </list>
            </pair>
        </dict>
        <dict name="lksd">
            <pair>
                <label value="//pkg:data.txt"/>
                <string value="d"/>
            </pair>
        </dict>
        <dict name="skld">
            <pair>
                <string value="key"/>
                <label value="//pkg:data.txt"/>
            </pair>
        </dict>
        <output name="out" value="//pkg:single.out"/>
        <list name="outs">
            <output value="//pkg:multi1.out"/>
            <output value="//pkg:multi2.out"/>
        </list>
        <rule-input name="//other:thing"/>
        <rule-input name="//pkg:data.txt"/>
        <rule-input name="//pkg:tool.sh"/>
        <rule-output name="//pkg:single.out"/>
        <rule-output name="//pkg:multi1.out"/>
        <rule-output name="//pkg:multi2.out"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <rule class="kitchen_bin" location="${WORKSPACE}/pkg/BUILD.bazel:100:12" name="//pkg:bin">
        <string name="name" value="bin"/>
        <list name="srcs">
            <label value="//pkg:tool.sh"/>
        </list>
        <rule-input name="//pkg:tool.sh"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <source-file location="${WORKSPACE}/pkg/data.txt:1:1" name="//pkg:data.txt">
        <visibility-label name="//visibility:public"/>
    </source-file>
    <rule class="genrule" location="${WORKSPACE}/pkg/BUILD.bazel:111:8" name="//pkg:gen">
        <string name="name" value="gen"/>
        <list name="srcs">
            <label value="//pkg:data.txt"/>
        </list>
        <list name="tools">
            <label value="//pkg:tool"/>
        </list>
        <list name="outs">
            <output value="//pkg:gen.out"/>
            <output value="//pkg:gen2.out"/>
        </list>
        <string name="cmd" value="cp $(location data.txt) $(location gen.out) &amp;&amp; echo &gt; $(location gen2.out)"/>
        <string name="message" value="generating"/>
        <tristate name="stamp" value="YES"/>
        <rule-input name="//pkg:data.txt"/>
        <rule-input name="//pkg:tool"/>
        <rule-input name="@bazel_tools//tools/genrule:genrule-setup.sh"/>
        <rule-output name="//pkg:gen.out"/>
        <rule-output name="//pkg:gen2.out"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <generated-file generating-rule="//pkg:gen" location="${WORKSPACE}/pkg/BUILD.bazel:111:8" name="//pkg:gen.out"/>
    <generated-file generating-rule="//pkg:gen" location="${WORKSPACE}/pkg/BUILD.bazel:111:8" name="//pkg:gen2.out"/>
    <rule class="test_suite" location="${WORKSPACE}/pkg/BUILD.bazel:140:11" name="//pkg:implicit_suite">
        <string name="name" value="implicit_suite"/>
        <list name="$implicit_tests">
            <label value="//pkg:unit_test"/>
        </list>
        <rule-input name="//pkg:unit_test"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <generated-file generating-rule="//pkg:all_types" location="${WORKSPACE}/pkg/BUILD.bazel:16:8" name="//pkg:multi1.out"/>
    <generated-file generating-rule="//pkg:all_types" location="${WORKSPACE}/pkg/BUILD.bazel:16:8" name="//pkg:multi2.out"/>
    <rule class="filegroup" location="${WORKSPACE}/pkg/BUILD.bazel:142:12" name="//pkg:pair">
        <string name="name" value="pair"/>
        <string name="generator_name" value="pair"/>
        <string name="generator_function" value="legacy_pair"/>
        <string name="generator_location" value="pkg/BUILD.bazel:142:12"/>
        <list name="srcs">
            <label value="//pkg:pair_a"/>
        </list>
        <rule-input name="//pkg:pair_a"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <rule class="kitchen" location="${WORKSPACE}/pkg/BUILD.bazel:142:12" name="//pkg:pair_a">
        <string name="name" value="pair_a"/>
        <string name="generator_name" value="pair"/>
        <string name="generator_function" value="legacy_pair"/>
        <string name="generator_location" value="pkg/BUILD.bazel:142:12"/>
        <string name="s" value="a"/>
        <rule-input name="//other:thing"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <rule class="kitchen" location="${WORKSPACE}/pkg/BUILD.bazel:95:8" name="//pkg:plain">
        <string name="name" value="plain"/>
        <list name="visibility">
            <label value="//visibility:private"/>
        </list>
        <rule-input name="//other:thing"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <rule class="kitchen" location="${WORKSPACE}/pkg/BUILD.bazel:56:8" name="//pkg:selects">
        <string name="name" value="selects"/>
        <string configurable="yes" name="s"/>
        <int configurable="yes" name="i"/>
        <boolean name="b" value="true"/>
        <label name="lbl" value="//pkg:data.txt"/>
        <list name="lbls">
            <label value="//pkg:data.txt"/>
            <label value="//other:thing"/>
            <label value="//pkg:tool.sh"/>
        </list>
        <list name="strs">
            <string value="f"/>
            <string value="s"/>
        </list>
        <list name="ints">
            <int value="7"/>
        </list>
        <dict name="sd">
            <pair>
                <string value="a"/>
                <string value="1"/>
            </pair>
            <pair>
                <string value="b"/>
                <string value="2"/>
            </pair>
        </dict>
        <rule-input name="//conf:fast"/>
        <rule-input name="//conf:slow"/>
        <rule-input name="//other:thing"/>
        <rule-input name="//pkg:data.txt"/>
        <rule-input name="//pkg:tool.sh"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <generated-file generating-rule="//pkg:all_types" location="${WORKSPACE}/pkg/BUILD.bazel:16:8" name="//pkg:single.out"/>
    <rule class="test_suite" location="${WORKSPACE}/pkg/BUILD.bazel:135:11" name="//pkg:suite">
        <string name="name" value="suite"/>
        <list name="tests">
            <label value="//pkg:unit_test"/>
        </list>
        <rule-input name="//pkg:unit_test"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <rule class="filegroup" location="${WORKSPACE}/pkg/BUILD.bazel:124:10" name="//pkg:tool">
        <string name="name" value="tool"/>
        <list name="srcs">
            <label value="//pkg:tool.sh"/>
        </list>
        <list name="data">
            <label value="//pkg:data.txt"/>
        </list>
        <rule-input name="//pkg:data.txt"/>
        <rule-input name="//pkg:tool.sh"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <source-file location="${WORKSPACE}/pkg/tool.sh:1:1" name="//pkg:tool.sh">
        <package-group name="//vis:friends"/>
        <visibility-label name="//vis:friends"/>
    </source-file>
    <rule class="kitchen_test" location="${WORKSPACE}/pkg/BUILD.bazel:105:13" name="//pkg:unit_test">
        <string name="name" value="unit_test"/>
        <string name="size" value="small"/>
        <list name="srcs">
            <label value="//pkg:data.txt"/>
        </list>
        <rule-input name="//pkg:data.txt"/>
        <rule-input name="@bazel_tools//tools/test:collect_coverage"/>
        <rule-input name="@bazel_tools//tools/test:coverage_report_generator"/>
        <rule-input name="@bazel_tools//tools/test:coverage_support"/>
        <rule-input name="@bazel_tools//tools/test:runtime"/>
        <rule-input name="@bazel_tools//tools/test:test_setup"/>
        <rule-input name="@bazel_tools//tools/test:test_wrapper"/>
        <rule-input name="@bazel_tools//tools/test:test_xml_generator"/>
        <rule-input name="@bazel_tools//tools/test:xml_writer"/>
        <rule-default-setting name="feat_a"/>
        <rule-default-setting name="-feat_b"/>
    </rule>
    <source-file location="${WORKSPACE}/vis/BUILD.bazel:1:1" name="//vis:BUILD.bazel" package_contains_errors="false">
        <visibility-label name="//visibility:private"/>
    </source-file>
    <package-group location="${WORKSPACE}/vis/BUILD.bazel:1:14" name="//vis:friends">
        <list name="includes">
            <label value="//vis:more"/>
        </list>
        <list name="packages">
            <string value="//other"/>
            <string value="//pkg/..."/>
