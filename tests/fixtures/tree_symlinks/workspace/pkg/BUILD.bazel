load(":defs.bzl", "inspect", "runner", "runner_test", "tree", "tree_alias")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "layer",
    outs = ["layer.tar"],
    cmd = "echo layer-bytes > $@",
)

# An OCI image layout with regular blobs (the base image of :oci_from).
tree(
    name = "base",
    cmd = """
mkdir -p "$1/blobs/sha256"
printf config > "$1/blobs/sha256/aaa"
printf manifest > "$1/blobs/sha256/bbb"
echo '{"schemaVersion": 2}' > "$1/index.json"
echo '{"imageLayoutVersion": "1.0.0"}' > "$1/oci-layout"
""",
)

# rules_oci image.sh add_layer with permits_treeartifact_uplevel_symlinks: a
# relative up-level link out of the tree to an input file.
tree(
    name = "uplevel",
    srcs = [":layer"],
    cmd = """
mkdir -p "$1/blobs/sha256"
ln -s "$(realpath --no-symlinks --canonicalize-missing --relative-to="$1/blobs/sha256" "$2")" "$1/blobs/sha256/layer"
echo '{}' > "$1/index.json"
""",
)

# rules_oci image.sh base_from + add_layer: every blob of an input tree
# linked relatively, then a layer.
tree(
    name = "oci_from",
    srcs = [
        ":base",
        ":layer",
    ],
    cmd = """
for blob in $(ls -1 -d "$2/blobs/"*/*); do
  relative_to_blobs="${blob#"$2/blobs"}"
  mkdir -p "$1/blobs/$(dirname "$relative_to_blobs")"
  ln -s "$(realpath --relative-to="$1/blobs/sha256" "$blob" --no-symlinks)" "$1/blobs/$relative_to_blobs"
done
cp --no-preserve=mode "$2/oci-layout" "$1/oci-layout"
cp --no-preserve=mode "$2/index.json" "$1/index.json"
ln --force --symbolic "$(realpath --no-symlinks --canonicalize-missing --relative-to="$1/blobs/sha256" "$3")" "$1/blobs/sha256/layer"
""",
)

# Relative links to a file inside the tree, from the root and from a
# subdirectory.
tree(
    name = "inside",
    cmd = """
printf a > "$1/a.txt"
ln -s a.txt "$1/alias.txt"
mkdir "$1/sub"
ln -s ../a.txt "$1/sub/up.txt"
""",
)

# A chain of links: a -> b -> c.
tree(
    name = "chain",
    cmd = """
printf c > "$1/c"
ln -s c "$1/b"
ln -s b "$1/a"
""",
)

# A directory link inside the tree; a file link inside the linked
# directory.
tree(
    name = "dir_inside",
    cmd = """
mkdir -p "$1/real/deeper"
printf f > "$1/real/f"
printf g > "$1/real/deeper/g"
ln -s f "$1/real/f2"
ln -s real "$1/alias"
""",
)

# A directory link out of the tree into an input tree.
tree(
    name = "dir_outside",
    srcs = [":base"],
    cmd = """
ln -s "$(realpath --relative-to="$1" "$2/blobs" --no-symlinks)" "$1/blobs"
printf own > "$1/own"
""",
)

# Relative links to source inputs: a plain file and an executable.
tree(
    name = "source_link",
    srcs = [
        "data.txt",
        "tool.sh",
    ],
    cmd = """
ln -s "$(realpath --relative-to="$1" "$2" --no-symlinks)" "$1/data.txt"
ln -s "$(realpath --relative-to="$1" "$3" --no-symlinks)" "$1/tool.sh"
""",
)

# A link to an empty directory: directories are not children.
tree(
    name = "empty_dir_link",
    cmd = """
mkdir "$1/empty"
ln -s empty "$1/empty_alias"
printf x > "$1/x"
""",
)

# A link to another output of the same action, outside the tree.
tree(
    name = "same_action",
    cmd = """
printf other > "$1.other"
ln -s ../same_action.other "$1/other"
""",
    sibling = True,
)

# An absolute link to a host file outside the workspace and execroot.
tree(
    name = "abs_host",
    cmd = """
ln -s /bin/sh "$1/sh"
printf x > "$1/x"
""",
)

# An absolute link to an input through the action's working directory:
# sandboxed (the default strategy) and unsandboxed.
tree(
    name = "absolute_sandboxed",
    srcs = [":layer"],
    cmd = """
ln -s "$PWD/$2" "$1/abs"
""",
)

tree(
    name = "absolute_local",
    srcs = [":layer"],
    cmd = """
ln -s "$PWD/$2" "$1/abs"
""",
    local = True,
)

# Invalid trees.
tree(
    name = "dangling_rel",
    cmd = """
printf x > "$1/x"
ln -s missing "$1/y"
""",
)

tree(
    name = "dangling_abs",
    cmd = """
ln -s /nonexistent/tree-symlinks-target "$1/y"
""",
)

tree(
    name = "special",
    cmd = """
ln -s /dev/null "$1/null"
""",
)

tree(
    name = "loop",
    cmd = """
ln -s b "$1/a"
ln -s a "$1/b"
""",
)

tree(
    name = "dir_cycle",
    cmd = """
mkdir "$1/sub"
printf s > "$1/sub/s"
ln -s .. "$1/sub/up"
""",
)

tree(
    name = "self_cycle",
    cmd = """
printf r > "$1/r"
ln -s . "$1/self"
""",
)

# A relative link to a source file that is not an input of the action.
tree(
    name = "undeclared",
    cmd = """
ln -s ../../../../../pkg/undeclared.txt "$1/x"
""",
)

# ctx.actions.symlink of a tree with links.
tree_alias(
    name = "aliased",
    tree = ":uplevel",
)

[
    inspect(
        name = "inspect_" + name,
        tree = ":" + name,
    )
    for name in [
        "uplevel",
        "oci_from",
        "inside",
        "chain",
        "dir_inside",
        "dir_outside",
        "source_link",
        "empty_dir_link",
        "same_action",
        "abs_host",
        "absolute_sandboxed",
        "absolute_local",
        "undeclared",
        "aliased",
    ]
]

runner(
    name = "show_uplevel",
    expect = {
        "blobs/sha256/layer": "layer-bytes",
        "index.json": "{}",
    },
    tree = ":uplevel",
)

runner_test(
    name = "uplevel_test",
    expect = {
        "blobs/sha256/layer": "layer-bytes",
        "index.json": "{}",
    },
    tree = ":uplevel",
)

runner_test(
    name = "dir_inside_test",
    expect = {
        "alias/deeper/g": "g",
        "alias/f": "f",
        "alias/f2": "f",
        "real/f2": "f",
    },
    tree = ":dir_inside",
)
