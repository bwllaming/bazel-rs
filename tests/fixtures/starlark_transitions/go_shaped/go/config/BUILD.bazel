load(
    "@bazel_skylib//rules:common_settings.bzl",
    "bool_flag",
    "string_flag",
    "string_list_flag",
)

# Shaped after rules_go 0.63.0 go/config/BUILD.bazel.
bool_flag(name = "static", build_setting_default = False, scope = "universal", visibility = ["//visibility:public"])
