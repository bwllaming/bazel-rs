load(":defs.bzl", "alias", "extra_binary", "extra_test", "probe_binary", "probe_test", "store", "tree")

genrule(
    name = "gen",
    outs = ["gen.txt"],
    cmd = "echo gen > $@",
)

tree(name = "dir")

alias(
    name = "link",
    src = "src.txt",
)

# An actions.symlink alias of a generated file: in Bazel's execution root a
# symlink to the target's exec path, so its realpath is the target's
# (with_cfg.bzl's frontend links a transitioned cc_binary this way, and the
# binary's rpath `$ORIGIN` must be the target's directory).
alias(
    name = "genlink",
    src = ":gen",
)

FILES = ["src.txt", "sub/nested.txt", ":gen", ":dir", ":link", ":genlink"]

probe_test(name = "probe_test", data = FILES)

probe_test(name = "probe_local_test", data = FILES, tags = ["no-sandbox"])

probe_binary(name = "probe", data = FILES)

store(name = "store")

extra_test(
    name = "extra_test",
    data = [":store", "srcdir"],
    gen = ":gen",
    src = "src.txt",
)

extra_test(
    name = "extra_local_test",
    data = [":store", "srcdir"],
    gen = ":gen",
    src = "src.txt",
    tags = ["no-sandbox"],
)

extra_binary(
    name = "extra",
    data = [":store", "srcdir"],
    gen = ":gen",
    src = "src.txt",
)
