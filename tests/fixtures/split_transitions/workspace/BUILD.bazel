load(":defs.bzl", "consumer", "dep", "setting")
platform(name = "platform")
setting(name = "flag", build_setting_default = "base")
config_setting(name = "dbg", flag_values = {"//:flag": "dbg"})
dep(name = "dep", srcs = select({":dbg": ["selected.txt"], "//conditions:default": ["other.txt"]}), tool = select({":dbg": ":dbg_tool", "//conditions:default": ":opt_tool"}))
dep(name = "dep2", srcs = ["other.txt"])
dep(name = "extra", srcs = ["other.txt"])
filegroup(name = "dbg_tool", srcs = ["tool-a"])
filegroup(name = "opt_tool", srcs = ["tool-b"])
consumer(name = "use", one = ":dep", many = [":dep2", ":dep"], source = "input.txt", empty = ":dep", patch = ":dep", aspected = [":dep"])
