"""The repository rule generated by the fixture extensions."""

def _gen_repo_impl(rctx):
    rctx.file("BUILD.bazel", "filegroup(name = \"x\", visibility = [\"//visibility:public\"])\n")

gen_repo = repository_rule(
    implementation = _gen_repo_impl,
    attrs = {
        "s": attr.string(),
        "i": attr.int(),
        "b": attr.bool(),
        "l": attr.label(),
        "ll": attr.label_list(),
        "sl": attr.string_list(),
        "sd": attr.string_dict(),
        "sld": attr.string_list_dict(),
        "lksd": attr.label_keyed_string_dict(),
    },
)
