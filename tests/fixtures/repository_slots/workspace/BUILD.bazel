genrule(
    name = "read_links",
    srcs = [
        "@linker//:through_path",
        "@linker//:relative",
        "@linker//:absolute",
        "@linker//:inside_relative",
        "@linker//:inside_absolute",
    ],
    outs = ["read_links.txt"],
    cmd = "cat $(SRCS) > $@",
)

exports_files(["cache_stamp.txt"])

genrule(
    name = "cache_runs",
    srcs = ["@cache_user//:runs.txt"],
    outs = ["cache_runs.txt"],
    cmd = "cat $< > $@",
)
