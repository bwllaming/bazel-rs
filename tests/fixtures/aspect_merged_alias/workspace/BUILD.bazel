load(":defs.bzl", "lib", "one")
lib(name = "q")
alias(name = "q_alias", actual = ":q")
lib(name = "p", deps = [":q_alias"])
lib(name = "r", deps = [":q"])
alias(name = "p_alias", actual = ":p")
one(name = "a_through_alias", deps = [":p_alias"], loc = "$(location :p_alias)")
one(name = "b_direct", deps = [":p"], loc = "$(location :p)")
one(name = "c_alias_again", deps = [":p_alias", ":r"], loc = "$(location :p_alias)")
