load("//:defs.bzl", "talk", "nomsg")
genrule(name = "g", outs = ["g.txt"], cmd = "echo hello-stdout; echo hello-stderr >&2; echo x > $@")
genrule(name = "gm", outs = ["gm.txt"], cmd = "echo msg; touch $@", message = "Custom message here")
talk(name = "t")
nomsg(name = "n")
genrule(name = "quiet", outs = ["q.txt"], cmd = "touch $@")
genrule(name = "usetool", outs = ["u.txt"], cmd = "$(location //tool:gen) > $@", tools = ["//tool:gen"])
genrule(name = "partial", outs = ["p.txt"], cmd = "printf 'no-newline-out'; printf 'no-newline-err' >&2; touch $@")
load("//:defs.bzl", "usetool")
usetool(name = "ut")
