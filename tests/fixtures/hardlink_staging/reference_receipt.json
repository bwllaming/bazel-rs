 "mismatch_analysis": {
  "reference-default|in_action:source_lstat": {
   "reference": "symbolic link",
   "native": "regular file",
   "explanation": "Bazel sandboxes stage every input as a symlink (SymlinkedSandboxedSpawn.copyFile, :128-129); native stages hardlinks (regular files), like Bazel's hermetic linux-sandbox (HardlinkedSandboxedSpawn, :75-102). Followed bytes, identity and executable bits agree."
  },
  "reference-default|in_action:source_mode": {
   "reference": "644",
   "native": "444",
   "explanation": "Inputs are hardlinks to read-only store blobs (0444 plus the keyed executable bits) so an in-place write cannot corrupt the content-addressed store shared by every action; Bazel stages a symlink into the execroot whose target is the writable source file (0644). Only the write bits differ; executable bits are equal and keyed."
  },
  "reference-default|in_action:source_writable": {
   "reference": "yes",
   "native": "no",
   "explanation": "Same cause as source_mode: native store blobs are read-only. Bazel local and processwrapper-sandbox expose the writable source through symlinks (linux-sandbox, unavailable here, mounts it read-only so access(W_OK) fails there too)."
  },
  "reference-default|in_action:virtual_lstat": {
   "reference": "symbolic link",
   "native": "regular file",
   "explanation": "Same cause as source_lstat: inside the action native inputs are hardlinks, never symlinks; Bazel exposes the symlink output (and in sandboxes a symlink to it)."
