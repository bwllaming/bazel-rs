load(
    ":defs.bzl",
    "aspect_consumer",
    "compile",
    "consumer",
    "expand",
    "grouped",
    "owners",
    "plain",
    "runner",
    "tool",
    "tree",
    "tree_consumer",
    "writer",
)

tool(name = "tool")

tool(name = "other_tool")

# rules_pkg's //pkg/private:archive and :helpers shape: two targets
# precompile the package's __init__.py into one output.
compile(
    name = "a",
    srcs = [
        "__init__.py",
        "a.py",
    ],
)

compile(
    name = "b",
    srcs = [
        "__init__.py",
        "b.py",
    ],
)

consumer(
    name = "both",
    deps = [
        ":a",
        ":b",
    ],
)

# Differs from :a's __init__ action in one compared part each.
compile(
    name = "c_args",
    srcs = ["__init__.py"],
    mode = "other",
)

compile(
    name = "c_tags",
    srcs = ["__init__.py"],
    tags = ["no-remote"],
)

compile(
    name = "c_mnemonic",
    srcs = ["__init__.py"],
    mnemonic = "OtherCompile",
)

compile(
    name = "c_env",
    srcs = ["__init__.py"],
    env = {"X": "1"},
)

compile(
    name = "c_inputs",
    srcs = ["__init__.py"],
    extra_inputs = ["extra.txt"],
)

compile(
    name = "c_tool",
    srcs = ["__init__.py"],
    tool = ":other_tool",
)

compile(
    name = "c_props",
    srcs = ["__init__.py"],
    exec_properties = {"key": "value"},
)

# Tags that are no execution requirements are not keyed.
compile(
    name = "c_plain_tags",
    srcs = ["__init__.py"],
    tags = ["plain-tag"],
)

# The execution info is keyed as one map (TargetUtils.getFilteredExecutionInfo):
# a requirement equal to :c_tags' propagated tag, a requirement that is no
# execution requirement, and one whose value differs from the tag's.
compile(
    name = "c_req_tag",
    srcs = ["__init__.py"],
    requirements = {"no-remote": ""},
)

compile(
    name = "c_req_illegal",
    srcs = ["__init__.py"],
    requirements = {"not-a-requirement": "1"},
)

compile(
    name = "c_req_value",
    srcs = ["__init__.py"],
    requirements = {"no-remote": "1"},
)

# Writes: one declared file and one output-file target on one path.
writer(
    name = "w_declared",
    path = "w.txt",
)

writer(
    name = "w_output",
    out = "w.txt",
)

writer(
    name = "w_other",
    content = "other content\n",
    path = "w.txt",
)

owners(
    name = "w_owners",
    srcs = [":w.txt"],
)

# An output below another target's output.
writer(
    name = "p_parent",
    path = "p",
)

writer(
    name = "p_child",
    path = "p/x",
)

# Exec groups: the group's name is not keyed, its exec properties are.
grouped(
    name = "g_one",
    group = "g1",
)

grouped(
    name = "g_two",
    group = "g2",
)

grouped(
    name = "g_props",
    exec_properties = {"g1.key": "value"},
    group = "g1",
)

# An aspect applied to two targets registers one spawn twice on one path:
# shared (the base targets' exec_properties are not the aspect actions'),
# unless the spawns differ.
plain(
    name = "aspect_base_x",
    exec_properties = {"key": "x"},
)

plain(
    name = "aspect_base_y",
    exec_properties = {"key": "y"},
)

plain(
    name = "aspect_base_z",
    content = "other aspect content\n",
)

aspect_consumer(
    name = "aspect_both",
    deps = [
        ":aspect_base_x",
        ":aspect_base_y",
    ],
)

aspect_consumer(
    name = "aspect_conflict",
    deps = [
        ":aspect_base_x",
        ":aspect_base_z",
    ],
)

# One tree artifact declared by two targets.
tree(name = "tree_a")

tree(name = "tree_b")

tree_consumer(
    name = "tree_both",
    deps = [
        ":tree_a",
        ":tree_b",
    ],
)

# //pkg:b's Files as runfiles of an executable that also depends on //pkg:a.
runner(
    name = "run_shared",
    deps = [
        ":a",
        ":b",
    ],
)

# Identical Args writes expanding a tree artifact in two targets.
expand(name = "expand_a")

expand(name = "expand_b")
