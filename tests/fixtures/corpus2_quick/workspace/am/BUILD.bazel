load(":defs.bzl", "fwd_append", "fwd_reset", "setting", "show")
setting(name = "f", build_setting_default = "d")
config_setting(name = "is_a", flag_values = {":f": "a"})
config_setting(name = "is_d", flag_values = {":f": "d"})
config_setting(name = "is_t", flag_values = {":f": "t"})
config_setting(name = "is_comma", flag_values = {":f": "a,b"})
show(name = "s", sel = select({":is_a": "a", ":is_d": "d", ":is_comma": "comma", "//conditions:default": "none"}))
fwd_append(name = "ap", dep = ":s")
fwd_reset(name = "re", dep = ":s")
show(name = "s2", sel = select({":is_t": "t", "//conditions:default": "none"}))
fwd_append(name = "ap2", dep = ":s2")
