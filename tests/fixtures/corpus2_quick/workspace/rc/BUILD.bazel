load(":defs.bzl", "exe", "r")
exe(name = "tool", extra = "data.txt")
filegroup(name = "fg", srcs = ["a.txt", "b.txt"])
r(name = "t1", cmd = "echo hi", tools = [])
r(name = "t2", cmd = "$(execpath :tool) $(locations :fg) $(location src.txt) $(execpath :c.txt) $$x", expand = True, tools = [":tool", ":fg"], extra = ":extra_alias", srcs = ["src.txt"])
r(name = "t3", cmd = "x $(FOO) $(COMPILATION_MODE)", make = True, tools = [":tool"])
r(name = "t4", cmd = "$(location :nope)", expand = True, attribute = "cmd")
r(name = "t5", cmd = "$(location :nope)", expand = True)
r(name = "t6", cmd = "$(UNDEF)", make = True)
alias(name = "extra_alias", actual = "c.txt")
