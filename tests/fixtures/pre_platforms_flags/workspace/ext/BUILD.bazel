load(":defs.bzl", "matched", "probe")

package(default_visibility = ["//visibility:public"])

# Like @protobuf//build_defs:config_android-legacy-default-crosstool.
config_setting(
    name = "android_legacy",
    values = {"crosstool_top": "//external:android/crosstool"},
)

config_setting(
    name = "crosstool_default",
    values = {"crosstool_top": "@bazel_tools//tools/cpp:toolchain"},
)

# Label.parseCanonical: `//pkg:my_crosstool` is the MAIN repository's label.
config_setting(
    name = "crosstool_main_custom",
    values = {"crosstool_top": "//pkg:my_crosstool"},
)

config_setting(
    name = "cpu_k8",
    values = {"cpu": "k8"},
)

config_setting(
    name = "cpu_win32",
    values = {"cpu": "win32"},
)

config_setting(
    name = "host_cpu_k8",
    values = {"host_cpu": "k8"},
)

config_setting(
    name = "crosstool_bad",
    values = {"crosstool_top": "a:b:c"},
)

probe(
    name = "p_all",
    matches = matched([
        ":android_legacy",
        ":crosstool_default",
        ":crosstool_main_custom",
        ":cpu_k8",
        ":cpu_win32",
        ":host_cpu_k8",
    ]),
)

probe(
    name = "p_bad",
    matches = matched([":crosstool_bad"]),
)

# A main-repository config_setting selected from an external repository
# still warns (the setting's own repository decides).
probe(
    name = "p_main",
    matches = matched(["@@//pkg:cpu_k8"]),
)
