genrule(name = "a", srcs = ["s.txt", ":b"], outs = ["a.out"], cmd = "cat $(SRCS) > $@")
filegroup(name = "b", srcs = ["t.txt", "//other:c"])
genquery(name = "q", expression = "deps(:a)", scope = [":a"])
genquery(name = "qk", expression = "deps(//pkg:a)", scope = [":a"], opts = ["--output=label_kind"])
genquery(name = "qb", expression = "kind(genrule, deps(//pkg:a))", scope = [":a"], opts = ["--output=build"])
genquery(name = "qx", expression = "deps(//pkg:a)", scope = [":b"])
genquery(name = "qns", expression = "deps(//pkg:a)", scope = [":b"], strict = False)
genquery(name = "qz", expression = "//pkg:a", scope = [":a"], compressed_output = True)
genquery(name = "qw", expression = "//pkg:*", scope = [":a"])
genquery(name = "qp", expression = "somepath(//pkg:a, //other:c)", scope = [":a"])
