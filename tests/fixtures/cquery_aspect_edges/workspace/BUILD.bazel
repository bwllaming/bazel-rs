load(":defs.bzl", "collect", "decorated", "node", "tc_impl", "exec_collect")
platform(name = "platform")
config_setting(name = "on", define_values = {"branch": "one"})
config_setting(name = "aspect_on", define_values = {"aspect": "one"})
node(name = "chosen", srcs = ["selected.txt"])
node(name = "ignored", srcs = ["unselected.txt"])
node(name = "branch", deps = select({":on": [":chosen"], "//conditions:default": [":ignored"]}))
collect(name = "requester", target = ":branch")
collect(name = "twin", target = ":branch")
exec_collect(name = "exec_requester", target = ":branch")
node(name = "plain", deps = [":branch"])
alias(name = "alias", actual = ":branch")
collect(name = "via_alias", target = ":alias")
decorated(name = "decorated", deps = [":chosen"])
collect(name = "via_decorated", target = ":decorated")
filegroup(name = "choice", srcs = select({":aspect_on": ["aspect-selected.txt"], "//conditions:default": ["aspect-other.txt"]}))
filegroup(name = "tool", srcs = ["tool.txt"])
toolchain_type(name = "tc_type")
tc_impl(name = "tc_impl", srcs = ["tc.txt"])
toolchain(name = "tc", toolchain_type = ":tc_type", toolchain = ":tc_impl")
exports_files(["witness.txt", "other-aspect.txt", "exec-source.txt"])
