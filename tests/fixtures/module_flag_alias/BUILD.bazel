load(":defs.bzl", "string_flag", "bool_flag", "int_flag", "private_setting", "reader", "through_transition")
platform(name = "platform")
string_flag(name = "text", build_setting_default = "root")
string_flag(name = "other", build_setting_default = "other")
bool_flag(name = "enabled", build_setting_default = False)
int_flag(name = "count", build_setting_default = 1)
private_setting(name = "private", build_setting_default = "private")
config_setting(name = "chosen", values = {"flavor": "yes"})
reader(name = "read", flags = [":text", ":other", ":enabled", ":count", "@dep//:text"], selected = select({":chosen": "match", "//conditions:default": "no"}))
through_transition(name = "transitioned", dep = ":read")
