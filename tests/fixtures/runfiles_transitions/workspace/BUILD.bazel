load(":defs.bzl", "aspect_use", "bin", "changed_bin", "changed_test", "changed_view", "exec_view", "native_setting", "split_view", "use", "view")
platform(name = "p")
config_setting(name = "links", values = {"build_runfile_links": "true"})
native_setting(name = "native_links", values = {"build_runfile_links": "1"})
bin(name = "exe")
changed_bin(name = "incoming_off", mode = "off")
changed_bin(name = "incoming_no", mode = "no")
changed_bin(name = "incoming_none", mode = "no_manifests")
changed_test(name = "off_test", mode = "off")
changed_test(name = "no_test", mode = "no")
changed_test(name = "none_test", mode = "no_manifests")
view(name = "plain", dep = ":exe", links_match = select({":links": True, "//conditions:default": False}), native_match = select({":native_links": True, "//conditions:default": False}))
changed_view(name = "off", dep = ":exe", mode = "off")
changed_view(name = "on", dep = ":exe", mode = "on")
changed_view(name = "no", dep = ":exe", mode = "no")
changed_view(name = "none", dep = ":exe", mode = "no_manifests")
changed_view(name = "bad", dep = ":exe", mode = "invalid")
changed_view(name = "bad_string", dep = ":exe", mode = "invalid_string")
changed_view(name = "null", dep = ":exe", mode = "null")
changed_view(name = "bad_enum", dep = ":exe", mode = "invalid_enum")
changed_view(name = "null_enum", dep = ":exe", mode = "null_enum")
exec_view(name = "exec", dep = ":exe")
split_view(name = "split", dep = ":exe")
use(name = "tool_off", dep = ":exe", mode = "off")
use(name = "tool_no", dep = ":exe", mode = "no")
aspect_use(name = "aspect_off", dep = ":exe", mode = "off")
aspect_use(name = "aspect_no", dep = ":exe", mode = "no")
exports_files(["input.txt"])
