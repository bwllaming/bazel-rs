module(name = "fx")
bazel_dep(name = "dep", version = "1.0")
local_path_override(module_name = "dep", path = "dep")
bazel_dep(name = "dep_user", version = "1.0")
local_path_override(module_name = "dep_user", path = "dep_user")
ext = use_extension("//:ext.bzl", "ext")
use_repo(ext, "gen_a", "gen_b", alias_c = "gen_c")
override_repo(ext, gen_a = "dep")
override_repo(ext, "mine")
inject_repo(ext, "dep2", injected = "dep")
mine = use_repo_rule("//:ext.bzl", "plain")
mine(name = "mine", tag = "root")
dep2 = use_repo_rule("//:ext.bzl", "plain")
dep2(name = "dep2", tag = "root2")
