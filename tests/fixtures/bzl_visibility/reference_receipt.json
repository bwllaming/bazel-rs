  "labels": {
    "EXACT": "identical exit class and output bytes/artifact",
    "KNOWN_DIVERGENCE": "inner messages and native-test asserts match reference; only framing differs",
    "MISMATCH": "behavior, inner message text, or a native-test-asserted string absent from reference stderr"
  },
  "step_label_counts": {
    "EXACT": 16,
    "KNOWN_DIVERGENCE": 28,
    "MISMATCH": 2
  },
  "findings": {
    "rerun_note": "Second run against the rebuilt native binary after the N8 fixes. The 'first_capture_*' entries record the mismatches found by the first run (prior native binary) and are kept for history; step labels/counts in this receipt come from this run's data only. Only the native-test location assert strings in S were updated to the genuine '<WS>/<file>:L:C: ' form; no comparison was weakened.",
    "fixes_applied": [
      "violation location now '<absolute requesting file path>:L:C:' (1-based line, Latin-1 byte column of the load string, no end column) for BUILD and .bzl requesters",
      "bzl visibility() spec label syntax/errors ported from LabelParser/LabelValidator/RepositoryName.validate/Label.parseWithRepoContext (src/bazel_label.rs)"
    ],
    "remaining_divergences": [
      "BUILD-file undefined name: native generic starlark-rust 'Variable `visibility` not found' vs Bazel \"name 'visibility' is not defined\" (applies to every undefined name, not N8-specific)",
      "query failure exit 1 (native) vs 7 (Bazel)",
      "framing: native joins violations + summary in one error without ERROR:/'error loading package'/'Target parsing failed' wrappers; .bzl init failures wrapped as 'cannot evaluate <label>:' with starlark-rust traceback",
      "build success output: native stdout label<TAB>path vs Bazel stderr 'Target ... up-to-date'"
    ],
    "first_capture_mismatch_location_render": "Mirrored tests private_external/private_and_listed(c/sub)/bzl_to_bzl/module_extension(step 2) assert '<file>:L:C-ENDCOL: Starlark file ...' (e.g. 'BUILD.bazel:1:6-49:', '//b:user.bzl:1:6-23:', '//ext:ext.bzl:2:6-33:'); genuine Bazel 9.3 prints 'ERROR: <abs path>:L:C: Starlark file ...' with no end column, and for .bzl requesters the absolute file path (<WS>/b/user.bzl:1:6) instead of the label. The violation text after the location and the summary lines are verbatim equal; violation order equal.",
    "first_capture_mismatch_build_file_visibility_undefined": "BUILD-file visibility(): Bazel 'ERROR: <WS>/a/BUILD.bazel:1:1: name 'visibility' is not defined' (then no such target); native 'error: Variable `visibility` not found' (generic starlark-rust text). Exit class equal; native test only asserts substring 'visibility' and absence of 'load visibility', both true in reference.",
    "first_capture_mismatch_spec_parse_text": {
      "//b:foo": [
        "Bazel: invalid package name '//b:foo': invalid target name 'foo:__pkg__': target names may not contain ':'",
        "native: invalid package name '//b:foo': unsupported target name \"foo:__pkg__\": this implementation accepts only ASCII letters, digits, '_', '-', '.', '+' and '/' (a stricter subset of Bazel label syntax)"
      ],
      "//b/../c": [
        "Bazel: invalid package name '//b/../c': invalid package name 'b/../c': package name component contains only '.' characters",
        "native: invalid package name '//b/../c': invalid package path \"b/../c\": empty, '.' and '..' path components are not allowed"
      ],
      "@package_metadata": [
        "Bazel: invalid package name '@package_metadata': invalid repository name 'package_metadata:__pkg__': repo names may contain only A-Z, a-z, 0-9, '-', '_', '.' and '+'",
        "native: invalid package name '@package_metadata': repository-only label shorthand is unsupported: \"@package_metadata:__pkg__\"; use @repository//:target"
      ]
    },
    "first_capture_framing_only": [
      "query failure exit code 7 (Bazel) vs 1 (native)",
      "native joins violation lines + summary without ERROR: prefixes; Bazel wraps summary as \"error loading package '<pkg>': <summary>\" or, for the module extension, \"Target parsing failed due to unexpected exception: Error loading '//ext:ext.bzl' for module extensions, requested by <WS>/MODULE.bazel:4:16: <summary>: <summary>\"",
      "native wraps .bzl init failures as 'cannot evaluate //a:defs.bzl: Traceback ...' with label paths and 'error: <msg>' + caret; Bazel 'Traceback ... File \"<abs>\", line N, column C ... Error in visibility: <msg>' then \"error loading package 'a': initialization of module 'a/defs.bzl' failed\"",
      "build success: Bazel prints 'Target ... up-to-date' on stderr, native prints label<TAB>path on stdout; artifact bytes equal"
    ],
    "verbatim_matches": [
      "all 7 visibility() call-error inner messages (top-level, set-once, tuple type, list element type, negative pattern, 'a' package name, post-init call from BUILD)",
      "sorted(['public'], key=visibility) at top level -> 'load visibility may only be set at the top level, not inside a function' in both",
      "list comprehension at top level may call visibility() in both; private enforced",
      "unknown @nonexistent//b spec accepted at declaration in both; same-package load ok, //b denied",
      "@//b, @@//c/..., @main//d:__pkg__, @main//f:__subpackages__ grant in both; //e and //d/z denied; @package_metadata//b and @@package_metadata+//b do not grant main //b",
      "visibility([]) behaves as private; ['public'] and ['private', '//b'] accepted and //b may load; ['//b', '-//c'] -> 'Cannot use negative package patterns here'",
      "private use_extension entry file //ext:ext.bzl not checked from MODULE.bazel (build ok, artifact 'made by helper' both); its transitive private load is checked in both"
    ]
  },
