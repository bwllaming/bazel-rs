{
  "repos": [
    {
      "name": "basic_gazelle",
      "description": "rules_go examples/basic_gazelle: Go + gazelle go_deps (golang.org/x/net, testify), rules_go/gazelle bumped to the ~/code versions",
      "source": {
        "git": "https://github.com/bazel-contrib/rules_go",
        "commit": "fb591bc876354b939ef767887e772c15f679a283",
        "subdir": "examples/basic_gazelle"
      },
      "delete": [".bazelrc", ".bazelversion", "MODULE.bazel.lock"],
      "replace": [
        {"file": "MODULE.bazel", "old": "bazel_dep(name = \"rules_go\", version = \"0.52.0\")", "new": "bazel_dep(name = \"rules_go\", version = \"0.63.0\")"},
        {"file": "MODULE.bazel", "old": "bazel_dep(name = \"gazelle\", version = \"0.42.0\")", "new": "bazel_dep(name = \"gazelle\", version = \"0.51.3\")"},
        {"file": "MODULE.bazel", "old": "go_sdk.download(version = \"1.23.4\")", "new": "go_sdk.download(version = \"1.27.1\")"}
      ],
      "build_targets": ["//..."],
      "test_targets": ["//..."],
      "query": "//...",
      "source_edit": {"file": "printlinks.go", "append": "\nvar benchEdit{n} = {n}\n"},
      "build_edit": {"file": "BUILD.bazel", "append": "\nfilegroup(name = \"bench_edit_{n}\")\n"}
    },
    {
      "name": "gazelle",
      "description": "bazel-contrib/bazel-gazelle itself: ~250 packages, ~400 Go targets, 177 go_tests, go_deps; minus the targets bazel-rs cannot analyse yet (docs = stardoc/java_plugins_flag_alias, rules_testing analysis tests) and the go_bazel_test that runs Bazel",
      "source": {
        "git": "https://github.com/bazel-contrib/bazel-gazelle",
        "commit": "5cc8299af468de4290cf40f93b3ef046e866446d",
        "subdir": ""
      },
      "delete_named": [{"under": "vendor", "name": "BUILD.bazel"}],
      "replace": [
        {"file": "internal/env.bzl", "old": "for key in \"GONOPROXY\", \"GONOSUMDB\":", "new": "for key in (\"GONOPROXY\", \"GONOSUMDB\"):"}
      ],
      "build_targets": ["//...", "-//docs/...", "-//tests/bzlmod/...", "-//tests/cli/...", "-//tests/bzl_deps/...", "-//internal:gazelle_binary_test", "-//internal:gazelle_binary_test_test_0", "-//internal:gazelle_binary_test_test_1"],
      "test_targets": ["//...", "-//docs/...", "-//tests/bzlmod/...", "-//tests/cli/...", "-//tests/bzl_deps/...", "-//internal:gazelle_binary_test", "-//internal:gazelle_binary_test_test_0", "-//internal:gazelle_binary_test_test_1", "-//internal:bazel_test"],
      "query": "//...",
      "source_edit": {"file": "rule/rule.go", "append": "\nvar benchEdit{n} = {n}\n"},
      "build_edit": {"file": "rule/BUILD.bazel", "append": "\nfilegroup(name = \"bench_edit_{n}\")\n"}
    },
    {
      "name": "pip_parse",
      "description": "rules_python examples/pip_parse: hermetic CPython 3.14 + pip.parse hub (requests, sphinx, yamllint, s3cmd, libclang wheels), rules_python 1.7.0 from the BCR",
      "source": {
        "git": "https://github.com/bazel-contrib/rules_python",
        "commit": "9e587e8e0416f0b81143b9f6ff94547db49b05f6",
        "subdir": "examples/pip_parse"
      },
      "delete": [".bazelrc", "WORKSPACE", "WORKSPACE.bzlmod"],
      "replace": [
        {"file": "MODULE.bazel", "old": "bazel_dep(name = \"rules_python\", version = \"0.0.0\")\nlocal_path_override(\n    module_name = \"rules_python\",\n    path = \"../..\",\n)", "new": "bazel_dep(name = \"rules_python\", version = \"1.7.0\")"}
      ],
      "build_targets": ["//...", "-//:pip_parse_test"],
      "test_targets": ["//...", "-//:pip_parse_test"],
      "query": "//...",
      "source_edit": {"file": "main.py", "append": "\n_BENCH_EDIT = {n}\n"},
      "build_edit": {"file": "BUILD.bazel", "append": "\nfilegroup(name = \"bench_edit_{n}\")\n"}
    }
  ]
}
