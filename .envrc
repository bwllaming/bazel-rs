# No downloads or installation on directory entry. Run ./scripts/setup-rust.sh first.
export RUSTUP_HOME="$PWD/.direnv/rustup"
export CARGO_HOME="$PWD/.direnv/cargo"
export CARGO_TARGET_DIR="$PWD/target"
PATH_add "$CARGO_HOME/bin"
PATH_add "$PWD/target/release"
watch_file rust-toolchain.toml
if ! test -x "$CARGO_HOME/bin/rustup"; then
  log_error "Rust is not installed locally. Run ./scripts/setup-rust.sh"
fi
